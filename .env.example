# ==============================================================================
# CortexForge: Verified Project Memory Layer - Environment Configuration
# ==============================================================================

# Server Network Configuration
CORTEX_HOST=0.0.0.0
CORTEX_PORT=8000

# Database Storage: Dual-engine support (SQLite or PostgreSQL + pgvector)
# Local SQLite (Default, Zero-configuration):
CORTEX_DB_URL=sqlite+aiosqlite:///cortexforge.db

# Production PostgreSQL with pgvector:
# CORTEX_DB_URL=postgresql+asyncpg://cortex:cortex_secret@localhost:5432/cortexforge

# Redis Cache & PubSub (Optional for horizontal scaling)
# REDIS_URL=redis://localhost:6379/0

# Deployment environment. In 'production' or 'staging', CortexForge refuses to
# fall back to mock or deterministic-hash providers: fabricated text and
# non-semantic vectors must never reach durable cognitive state.
CORTEX_ENV=development

# Embedding Provider: 'local' or 'openai'.
#
# 'local' produces deterministic 384-dimensional hash vectors. They are
# reproducible and need no API key, which makes them right for tests, offline
# development and baseline benchmarking -- but they encode token overlap, not
# meaning, and must never share an index with real embeddings.
CORTEX_EMBEDDINGS_PROVIDER=local
# OPENAI_API_KEY=sk-...
# CORTEX_EMBEDDING_MODEL=text-embedding-3-small

# LLM Provider: 'mock' or 'openai'.
#
# 'mock' returns canned deterministic text. It is unavailable when CORTEX_ENV is
# production or staging, because an LLM here proposes knowledge and canned text
# proposing knowledge is fabrication.
CORTEX_LLM_PROVIDER=mock
# CORTEX_LLM_MODEL=gpt-4o-mini

# GitHub App Integration (webhook triggers for incremental updates on push/PR).
# Required in production: without it, unsigned webhooks would be an
# unauthenticated path into the project's cognitive state.
# GITHUB_WEBHOOK_SECRET=your_github_webhook_hmac_secret_here

# Telemetry & Observability: 'disabled' (default for privacy) or 'otlp'
CORTEX_TELEMETRY=disabled
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
